      "consumers": [
        {"kind": "platform", "name": "claude-code", "requirement": "target", "capability": "Skill discovery and evaluation", "fallback": null}
      ],
      "probe": {
        "candidates": [
          {"command": "claude", "arguments": ["--version"]}
        ],
        "version_pattern": null,
        "smoke_arguments": ["--version"],
        "may_launch_ui": false
      },
      "install": null,
      "guidance": null
    },
    {
      "id": "codex-cli",
      "kind": "platform-cli",
      "ecosystem": "system",
      "description": "Codex installation and evaluator target.",
      "minimum_version": null,
      "version_constraint": null,
      "install_version": null,
      "prerequisites": [],
      "consumers": [
        {"kind": "platform", "name": "codex", "requirement": "target", "capability": "Skill discovery and evaluation", "fallback": null}
      ],
      "probe": {
        "candidates": [
          {"command": "codex", "arguments": ["--version"]}
        ],
        "version_pattern": null,
