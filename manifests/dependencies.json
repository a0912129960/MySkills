      "description": "Antigravity CLI compatibility-copy target.",
      "minimum_version": null,
      "version_constraint": null,
      "install_version": null,
      "prerequisites": [],
      "consumers": [
        {"kind": "platform", "name": "antigravity-cli", "requirement": "target", "capability": "Skill compatibility copy", "fallback": null}
      ],
      "probe": {
        "candidates": [
          {"command": "agy", "arguments": ["--version"]},
          {"command": "%LOCALAPPDATA%\\agy\\bin\\agy.exe", "arguments": ["--version"]}
