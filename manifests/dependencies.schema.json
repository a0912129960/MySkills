{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a0912129960/MySkills/blob/main/manifests/dependencies.schema.json",
  "title": "MySkills dependency registry",
  "description": "Closed allowlist of runtime prerequisites, installable dependencies, and platform CLI probes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "dependencies"],
  "properties": {
    "$schema": {
      "const": "./dependencies.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    }
  },
  "$defs": {
    "nullableVersion": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "requirement", "capability", "fallback"],
      "properties": {
        "kind": {
          "enum": ["skill", "category", "platform"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "enum": ["required", "optional", "target"]
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requirement": {
                "const": "optional"
              }
            }
          },
          "then": {
            "properties": {
              "fallback": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "fallback": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "probeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "arguments"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "version_pattern",
        "smoke_arguments",
        "may_launch_ui"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/probeCandidate"
          }
        },
        "version_pattern": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "smoke_arguments": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "may_launch_ui": {
          "type": "boolean"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager", "package", "scope", "requirements_file"],
      "properties": {
        "manager": {
          "enum": ["pip", "node"]
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": ["private-venv", "global"]
        },
        "requirements_file": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[^\\\\]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ecosystem",
        "description",
        "minimum_version",
        "version_constraint",
        "install_version",
        "prerequisites",
        "consumers",
        "probe",
        "install",
        "guidance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": ["runtime-prerequisite", "installable", "platform-cli"]
        },
        "ecosystem": {
          "enum": ["system", "python", "node"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "minimum_version": {
          "$ref": "#/$defs/nullableVersion"
        },
        "version_constraint": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "install_version": {
          "$ref": "#/$defs/nullableVersion"
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consumer"
          }
        },
        "probe": {
          "$ref": "#/$defs/probe"
        },
        "install": {
          "oneOf": [
            {
              "$ref": "#/$defs/install"
            },
            {
              "type": "null"
            }
          ]
        },
        "guidance": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "installable"
              }
            }
          },
          "then": {
            "properties": {
              "install_version": {
                "type": "string"
              },
              "install": {
                "$ref": "#/$defs/install"
              }
            }
          },
          "else": {
            "properties": {
              "install_version": {
                "type": "null"
              },
              "install": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
