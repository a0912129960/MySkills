{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a0912129960/MySkills/blob/main/evaluations/cases.schema.json",
  "title": "MySkills behavioral evaluation cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "skills"],
  "properties": {
    "$schema": {"const": "./cases.schema.json"},
    "schema_version": {"const": 3},
    "fixture_sets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/fixture"}
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "assertions", "safety"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "prompt": {"type": "string", "minLength": 20},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3}
        },
        "safety": {"enum": ["read-only", "temporary-workspace"]},
        "fixture_sets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "fixtures": {
          "type": "array",
          "items": {"$ref": "#/$defs/fixture"}
        },
        "companion_skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "git_fixture": {"$ref": "#/$defs/gitFixture"},
        "runtime_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["obsidian-wiki", "skill-evaluator"]
          }
        },
        "external_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["qmd"]
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*[. ](?:/|$))(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)\\.(?:[Aa][Gg][Ee][Nn][Tt][Ss]|[Cc][Ll][Aa][Uu][Dd][Ee]|[Cc][Oo][Dd][Ee][Xx]|[Gg][Ee][Mm][Ii][Nn][Ii]|[Gg][Ii][Tt])(?:/|$))[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$"
        },
        "content": {"type": "string"}
      }
    },
    "gitFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_files", "working_tree_files"],
      "properties": {
        "baseline_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fixture"}
        },
        "working_tree_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/fixture"}
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "expected_invocation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "prompt": {"type": "string", "minLength": 20},
        "expected_invocation": {"enum": ["implicit", "manual-only"]},
        "fixture_sets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "fixtures": {
          "type": "array",
          "items": {"$ref": "#/$defs/fixture"}
        },
        "external_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["qmd"]
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_name",
        "evaluation_level",
        "required_cases",
        "trigger_cases"
      ],
      "properties": {
        "skill_name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "evaluation_level": {"const": "full"},
        "required_cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/case"}
        },
        "trigger_cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/trigger"}
        }
      }
    }
  }
}
