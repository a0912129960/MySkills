{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a0912129960/MySkills/blob/main/evaluations/cases.schema.json",
  "title": "MySkills behavioral evaluation cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "skills"],
  "properties": {
    "$schema": {"const": "./cases.schema.json"},
    "schema_version": {"const": 1},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "assertions", "safety"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "prompt": {"type": "string", "minLength": 20},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3}
        },
        "safety": {"enum": ["read-only", "temporary-workspace"]}
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "expected_invocation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "prompt": {"type": "string", "minLength": 20},
        "expected_invocation": {"enum": ["implicit", "manual-only"]}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_name",
        "evaluation_level",
        "baseline",
        "required_cases",
        "trigger_cases"
      ],
      "properties": {
        "skill_name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "evaluation_level": {"const": "full"},
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identity"],
          "properties": {
            "kind": {"enum": ["no-skill", "previous-version"]},
            "identity": {"type": "string", "minLength": 1}
          }
        },
        "required_cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/case"}
        },
        "trigger_cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/trigger"}
        }
      }
    }
  }
}
