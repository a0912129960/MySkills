{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a0912129960/MySkills/blob/main/evaluations/cases.schema.json",
  "title": "MySkills evaluation case catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "skill_case_files"],
  "properties": {
    "$schema": {"const": "./cases.schema.json"},
    "schema_version": {"const": 4},
    "fixture_sets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/fixture"}
      }
    },
    "skill_case_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^cases/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*[. ](?:/|$))(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)\\.(?:[Aa][Gg][Ee][Nn][Tt][Ss]|[Cc][Ll][Aa][Uu][Dd][Ee]|[Cc][Oo][Dd][Ee][Xx]|[Gg][Ee][Mm][Ii][Nn][Ii]|[Gg][Ii][Tt])(?:/|$))[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$"
        },
        "content": {"type": "string"}
      }
    }
  }
}
