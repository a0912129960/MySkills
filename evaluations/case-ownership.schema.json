{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a0912129960/MySkills/blob/main/evaluations/case-ownership.schema.json",
  "title": "MySkills evaluation case authoring ownership",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "coordinator_owned", "agents"],
  "properties": {
    "$schema": {"const": "./case-ownership.schema.json"},
    "schema_version": {"const": 1},
    "coordinator_owned": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent-a", "agent-b", "agent-c"],
      "properties": {
        "agent-a": {"$ref": "#/$defs/caseFiles"},
        "agent-b": {"$ref": "#/$defs/caseFiles"},
        "agent-c": {"$ref": "#/$defs/caseFiles"}
      }
    }
  },
  "$defs": {
    "caseFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evaluations/cases/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
      }
    }
  }
}
