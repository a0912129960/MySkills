{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a0912129960/MySkills/blob/main/evaluations/record.schema.json",
  "title": "MySkills Skill evaluation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "run_id",
    "skill_name",
    "skill_digest",
    "case_manifest_digest",
    "evaluator_version",
    "started_at",
    "completed_at",
    "status",
    "targets",
    "human_review",
    "warnings",
    "sanitization"
  ],
  "properties": {
    "$schema": {"const": "../../../record.schema.json"},
    "schema_version": {"const": 2},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "skill_name": {"$ref": "#/$defs/kebab"},
    "skill_digest": {"$ref": "#/$defs/digest"},
    "case_manifest_digest": {"$ref": "#/$defs/digest"},
    "evaluator_version": {"const": "myskills-skill-evaluator/4"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"$ref": "#/$defs/resultStatus"},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": {"$ref": "#/$defs/target"},
        "codex": {"$ref": "#/$defs/target"}
      }
    },
    "human_review": {"$ref": "#/$defs/humanReview"},
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "sanitization": {"$ref": "#/$defs/sanitization"}
  },
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resultStatus": {
      "enum": ["pass", "fail", "invalid", "human-review-required"]
    },
    "stringAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unavailable_reason"],
      "properties": {
        "value": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "unavailable_reason": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "integerAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unavailable_reason"],
      "properties": {
        "value": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "unavailable_reason": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/kebab"},
        "kind": {
          "enum": ["deterministic", "human-rubric", "trajectory"]
        },
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "trajectory_observation": {
          "enum": ["tool-trace", "external-state", "verified-absence"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "trajectory"}},
            "required": ["kind"]
          },
          "then": {"required": ["trajectory_observation"]},
          "else": {"not": {"required": ["trajectory_observation"]}}
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation", "outcome", "assertions"],
      "properties": {
        "invocation": {
          "enum": ["explicit", "implicit", "not-invoked"]
        },
        "outcome": {"type": "string", "minLength": 1},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "name",
        "arguments",
        "status",
        "result_summary"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"},
        "status": {"enum": ["success", "failure"]},
        "result_summary": {"type": "string"}
      }
    },
    "unavailableObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "environmentIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "paths",
        "windows_home_matches_profile"
      ],
      "properties": {
        "schema_version": {"enum": [1, 2]},
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "USERPROFILE",
            "HOME",
            "CLAUDE_CONFIG_DIR",
            "APPDATA",
            "LOCALAPPDATA",
            "XDG_CONFIG_HOME",
            "XDG_CACHE_HOME"
          ],
          "properties": {
            "USERPROFILE": {"const": "profile-root"},
            "HOME": {"const": "profile-root"},
            "CLAUDE_CONFIG_DIR": {"const": "profile-root"},
            "APPDATA": {"const": "profile/AppData/Roaming"},
            "LOCALAPPDATA": {
              "enum": [
                "profile/AppData/Local",
                "workspace/.runtime/localappdata"
              ]
            },
            "XDG_CONFIG_HOME": {
              "enum": [
                "profile/.config",
                "workspace/.runtime/qmd/xdg-config"
              ]
            },
            "XDG_CACHE_HOME": {
              "enum": [
                "profile/.cache",
                "workspace/.runtime/qmd/cache"
              ]
            }
          }
        },
        "mcp_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "const": "workspace/.claude/empty-mcp.json"
            },
            "sha256": {
              "const": "sha256:d8e397af03b5b032f21d0aa967086f0c78b33c87b76f2e9898ae0a144df7de02"
            }
          }
        },
        "windows_home_matches_profile": {
          "oneOf": [
            {"const": true},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"schema_version": {"const": 2}},
            "required": ["schema_version"]
          },
          "then": {"required": ["mcp_config"]},
          "else": {"not": {"required": ["mcp_config"]}}
        }
      ]
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation",
        "invocation_evidence",
        "tool_calls",
        "final_output",
        "external_state",
        "environment_isolation",
        "unavailable"
      ],
      "properties": {
        "invocation": {
          "enum": ["explicit", "implicit", "not-invoked", "unknown"]
        },
        "invocation_evidence": {"type": "string", "minLength": 1},
        "tool_calls": {
          "type": "array",
          "items": {"$ref": "#/$defs/toolCall"}
        },
        "final_output": {
          "oneOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "external_state": {
          "oneOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "environment_isolation": {
          "oneOf": [
            {"$ref": "#/$defs/environmentIsolation"},
            {"type": "null"}
          ]
        },
        "unavailable": {
          "type": "array",
          "items": {"$ref": "#/$defs/unavailableObservation"}
        }
      }
    },
    "assertionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "status", "evidence", "observation"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/kebab"},
        "status": {"enum": ["pass", "fail", "invalid"]},
        "evidence": {"type": "string", "minLength": 1},
        "observation": {
          "enum": [
            "final-output",
            "tool-trace",
            "external-state",
            "verified-absence",
            "invocation-trace",
            "not-applicable"
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "reason", "corrective_action"],
      "properties": {
        "stage": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "reason": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "corrective_action": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_version",
        "kind",
        "prompt",
        "expected",
        "observed",
        "assertion_results",
        "status",
        "failure"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/kebab"},
        "case_version": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["core", "invocation", "golden"]},
        "prompt": {"type": "string", "minLength": 1},
        "expected": {"$ref": "#/$defs/expected"},
        "observed": {"$ref": "#/$defs/observed"},
        "assertion_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertionResult"}
        },
        "status": {"$ref": "#/$defs/resultStatus"},
        "failure": {"$ref": "#/$defs/failure"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "runner",
        "duration_ms",
        "total_tokens",
        "cases"
      ],
      "properties": {
        "status": {"$ref": "#/$defs/resultStatus"},
        "runner": {"$ref": "#/$defs/stringAvailability"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "total_tokens": {"$ref": "#/$defs/integerAvailability"},
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/case"}
        }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "reviewed_at",
        "reason",
        "corrective_action"
      ],
      "properties": {
        "status": {"enum": ["not-required", "pending", "pass"]},
        "reviewer": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "reviewed_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "reason": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "corrective_action": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "redactions", "human_confirmed"],
      "properties": {
        "status": {"const": "pass"},
        "human_confirmed": {"const": true},
        "redactions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
