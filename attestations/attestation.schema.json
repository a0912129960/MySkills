{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a0912129960/MySkills/blob/main/attestations/attestation.schema.json",
  "title": "MySkills Skill release record pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "skill_name",
    "skill_digest",
    "record_path",
    "record_digest",
    "selected_at",
    "status"
  ],
  "properties": {
    "$schema": {"const": "../attestation.schema.json"},
    "schema_version": {"const": 3},
    "skill_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skill_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_path": {
      "type": "string",
      "pattern": "^evaluations/records/[a-z0-9]+(?:-[a-z0-9]+)*/[A-Za-z0-9][A-Za-z0-9._-]*/record\\.json$"
    },
    "record_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selected_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {"const": "pass"}
  }
}
